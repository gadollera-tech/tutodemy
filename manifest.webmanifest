      "url": "./tutoring.html?source=pwa-shortcut",
      "icons": [
        {
          "src": "assets/images/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "My Dashboard",
      "short_name": "Dashboard",
      "description": "Open your learning dashboard",
      "url": "./dashboard.html?source=pwa-shortcut",
      "icons": [
        {
          "src": "assets/images/icon-192.png",
          "sizes": "192x192",
